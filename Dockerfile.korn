FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet publish Jellyfin.Server/Jellyfin.Server.csproj \
    --configuration Release \
    --runtime linux-x64 \
    --self-contained true \
    --output /out \
    -p:DebugType=none \
    -p:DebugSymbols=false \
    -p:PublishSingleFile=false

FROM jellyfin/jellyfin:latest
COPY --from=build /out/ /jellyfin/
COPY deployment/korn/web/korn-family-add.js /jellyfin/jellyfin-web/korn-family-add.js
RUN set -eux; \
    index=/jellyfin/jellyfin-web/index.html; \
    marker='<script defer="defer" src="korn-family-add.js?v=20260510-2"></script>'; \
    if ! grep -q 'korn-family-add.js' "$index"; then \
        sed -i "s#</head>#$marker</head>#" "$index"; \
    fi
